{
  "expo": {
    "name": "IngridJEN",
    "slug": "IngridJEN",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "ingridjen",
      "com.anonymous.ingridjen",
      "com.googleusercontent.apps.794528666075-nbrcoq95g122dkq78eo5i4e6bud8gckt"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A0B12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.IngridJEN"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#1A0B12",
          "dark": {
            "backgroundColor": "#1A0B12"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-av",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80b995d8-cc24-4491-89bd-323933107ccc"
      }
    },
    "owner": "abelazo16",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
